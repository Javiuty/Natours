---
import Heading3 from "./Heading3.astro";
import type { Feature } from "../data/site";

type Props = Feature;

const { icon, title, text } = Astro.props;
---

<div
  class="rounded-card bg-white/80 p-25 text-center text-15 shadow-card transition-transform duration-300 hover:-translate-y-15 hover:scale-103 tab-port:p-20"
>
  <i
    aria-hidden="true"
    class:list={[
      "mb-5 inline-block bg-linear-to-r/srgb from-primary-light to-primary-dark bg-clip-text text-60 text-transparent tab-port:mb-0",
      icon,
    ]}></i>
  <Heading3 class="mb-15">{title}</Heading3>
  <p>{text}</p>
</div>
