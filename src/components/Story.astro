---
import { Image } from "astro:assets";
import Heading3 from "./Heading3.astro";
import type { Story } from "../data/site";

type Props = Story;

const { image, name, title, text } = Astro.props;
---

<!-- La tarjeta va inclinada y su contenido se contrainclina para quedar recto.
     En móvil se desactivan las dos inclinaciones. -->
<div
  class="group mx-auto w-3/4 -skew-x-12 rounded-card bg-white/60 p-60 pl-90 text-16 shadow-story tab-port:w-full tab-port:p-40 tab-port:pl-70 phone:skew-x-0"
>
  <figure
    class="relative float-left h-150 w-150 -translate-x-30 skew-x-12 clip-circle shape-circle phone:skew-x-0"
  >
    {/* `max-w-none` desactiva el `max-width: 100%` que el reset de Tailwind
        pone a las imágenes: aquí la foto tiene que desbordar el círculo de
        15rem para que el recorte muestre solo el centro. Con el límite
        puesto se quedaba a 150px de ancho y salía deformada. */}
    <Image
      src={image}
      alt={`${name} on a tour`}
      class="h-full w-auto max-w-none -translate-x-40 scale-140 backface-hidden transition-all duration-500 group-hover:scale-100 group-hover:blur-[3px] group-hover:brightness-80"
    />
    <figcaption
      class="absolute top-1/2 left-1/2 -translate-x-1/2 translate-y-[20%] text-center text-17 uppercase text-white opacity-0 backface-hidden transition-all duration-500 group-hover:-translate-y-1/2 group-hover:opacity-100"
    >
      {name}
    </figcaption>
  </figure>

  <div class="skew-x-12 phone:skew-x-0">
    <Heading3 class="mb-15">{title}</Heading3>
    <p>{text}</p>
  </div>
</div>
