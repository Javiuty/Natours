---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-block border-b border-primary p-[3px] text-16 text-primary no-underline transition-all duration-200",
    "hover:-translate-y-[2px] hover:bg-primary hover:text-white hover:shadow-btn-text",
    "active:translate-y-0 active:shadow-btn-text",
    className,
  ]}
>
  <slot />
</a>
