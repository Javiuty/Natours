---
/**
 * El <h2> con degradado de la sección. El centrado y el margen inferior son
 * opcionales porque el formulario de reserva y el popup lo quieren alineado a
 * la izquierda y con otra separación.
 */
interface Props {
  centered?: boolean;
  class?: string;
}

const { centered = true, class: className } = Astro.props;
---

<div class:list={[centered && "mb-80 text-center tab-port:mb-50", className]}>
  <h2
    class="inline-block bg-linear-to-r/srgb from-primary-light to-primary-dark bg-clip-text text-35 font-bold uppercase tracking-[0.2rem] text-transparent transition-all duration-200 tab-port:text-30 phone:text-25 hover:[text-shadow:0.5rem_1rem_2rem_rgb(0_0_0/0.2)] hover:[transform:skewY(2deg)_skewX(15deg)_scale(1.1)]"
  >
    <slot />
  </h2>
</div>
