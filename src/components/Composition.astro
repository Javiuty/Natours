---
import { Image } from "astro:assets";
import nat1 from "../assets/nat-1-large.jpg";
import nat2 from "../assets/nat-2-large.jpg";
import nat3 from "../assets/nat-3-large.jpg";

// Se corrige el orden del `sizes` original: la condición de 56.25em iba delante
// de la de 37.5em y, como gana la primera que coincide, la de móvil nunca se
// llegaba a aplicar.
const sizes = "(max-width: 37.5em) 30vw, (max-width: 56.25em) 20vw, 300px";

const photo = [
  "absolute z-10 w-[55%] rounded-field shadow-photo outline-offset-[2rem] transition-all duration-200",
  // Se usan `scale`/`translate` (las propiedades sueltas que emite Tailwind) y
  // no un `transform` literal: en tablet las fotos ya llevan `scale-120`, y un
  // `transform` es una propiedad DISTINTA de `scale`, así que los dos se
  // aplicarían a la vez y el hover escalaría 1.26 en lugar de 1.05.
  "hover:z-20 hover:outline-solid hover:[outline-width:1.5rem] hover:outline-primary hover:shadow-photo-hover hover:scale-105 hover:-translate-y-5",
  // Las demás fotos se encogen mientras se señala una.
  "group-hover:not-hover:scale-95",
  // En tablet dejan de estar superpuestas y se ponen en fila.
  "tab-port:relative tab-port:w-1/3 tab-port:shadow-photo-flat",
].join(" ");

const photos = [
  { src: nat1, alt: "Photo 1", place: "left-0 -top-20 tab-port:top-0 tab-port:scale-120" },
  { src: nat2, alt: "Photo 2", place: "right-0 top-20 tab-port:-top-10 tab-port:z-150 tab-port:scale-130" },
  { src: nat3, alt: "Photo 3", place: "left-[20%] top-100 tab-port:top-10 tab-port:left-0 tab-port:scale-110" },
];
---

<div class="group relative tab-port:flex">
  {
    photos.map((item) => (
      <Image
        src={item.src}
        widths={[300, 1000]}
        sizes={sizes}
        alt={item.alt}
        class={`${photo} ${item.place}`}
      />
    ))
  }
</div>
